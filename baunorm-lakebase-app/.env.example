# Copy this file to .env for local development.
# In production on Databricks Apps, lakebase.py falls back to reading
# LAKEBASE_URL from the "database/lakebase-url" secret scope (see app.yaml),
# so you do NOT put a real secret value here or commit a filled-in .env.

LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# Optional overrides
# NORMEN_TABLE_NAME=normen
# FLASK_DEBUG=1
